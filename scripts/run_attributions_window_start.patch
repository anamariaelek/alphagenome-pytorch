+def manifest_offset(r, seq_len: int):
+    """Site offset requested by a manifest row, or None to centre the site.
+
+    Honours an optional ``window_start`` column (the genomic start of the evaluation
+    window, straight from the fold0 test BED); the offset is then
+    ``Position - window_start``. Absent, blank, or non-numeric means "centre it", so
+    manifests written before this column existed behave exactly as before.
+    """
+    ws = getattr(r, "window_start", None)
+    if ws is None or (isinstance(ws, float) and np.isnan(ws)):
+        return None
+    try:
+        ws = int(ws)
+    except (TypeError, ValueError):
+        return None
+    off = int(r.Position) - ws
+    if not 0 <= off < seq_len:
+        raise ValueError(
+            f"window_start={ws} puts Position={int(r.Position)} at offset {off}, outside "
+            f"the {seq_len} bp window ({getattr(r, 'species', '?')} "
+            f"{getattr(r, 'Chromosome', '?')}). Check the BED row is the one that "
+            f"actually produced this site's stored prediction.")
+    return off
 
 
